{
  "name": "dao-den-long",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.cli.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/unit/*.test.js dist-test/tests/scenarios/*.test.js",
    "verify": "npm run typecheck && npm run build && node scripts/verify.mjs",
    "headless": "node dist/cli/headless.js",
    "bench": "node dist/cli/bench.js",
    "soak": "node dist/cli/soak.js",
    "start": "node dist/cli/run.js"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
